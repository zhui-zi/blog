---
import PostMeta from '~/components/PostMeta.astro'
import type { Post } from '~/types'

interface Props {
  post: Post
  preload?: boolean
}

const { post, preload = false } = Astro.props
---

<article class="post-article prose">
  <PostMeta post={post} preload={preload} />
  <slot />
</article>
