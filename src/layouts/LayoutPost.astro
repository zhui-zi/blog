---
import PostMeta from '~/components/PostMeta.astro'
import type { Post } from '~/types'

interface Props {
  post: Post
  preload?: boolean
  detail?: boolean
}

const { post, preload = false, detail = false } = Astro.props
---

<article class:list={['post-article prose', { 'post-article-detail': detail }]}>
  <PostMeta post={post} preload={preload} />
  <slot />
</article>

<style is:global>
  .post-article-detail > header {
    margin-bottom: 2rem;
  }
</style>
