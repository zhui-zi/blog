<button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部" title="返回顶部" hidden>
  <span class="back-to-top-label" aria-hidden="true">Top</span>
  <svg class="back-to-top-icon" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M8 13V3M4.5 6.5 8 3l3.5 3.5"></path>
  </svg>
</button>

<script>
  interface BackToTopButton extends HTMLButtonElement {
    backToTopCleanup?: () => void
  }

  function setupBackToTop() {
    const main = document.querySelector<HTMLElement>('main.site-scrollbar')
    const button = document.querySelector<BackToTopButton>('[data-back-to-top]')

    button?.backToTopCleanup?.()
    if (!main || !button) {
      if (button) {
        button.hidden = true
      }
      return
    }

    const scroller = main.scrollHeight - main.clientHeight > 1 ? main : (document.scrollingElement as HTMLElement)
    const scrollTarget: EventTarget = scroller === document.scrollingElement ? window : scroller
    const controller = new AbortController()
    const { signal } = controller

    const update = () => {
      const isPost = Boolean(main.querySelector('.post-content'))
      button.hidden = !isPost || scroller.scrollTop < 480
    }

    scrollTarget.addEventListener('scroll', update, { passive: true, signal })
    button.addEventListener(
      'click',
      () => {
        scroller.scrollTo({ top: 0, behavior: 'smooth' })
      },
      { signal },
    )

    button.backToTopCleanup = () => controller.abort()
    update()
  }

  setupBackToTop()
  document.addEventListener('astro:page-load', setupBackToTop)
</script>

<style>
  .back-to-top {
    position: fixed;
    right: max(0.55rem, env(safe-area-inset-right));
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 20;
    display: flex;
    min-width: 3.5rem;
    height: 2rem;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    background: transparent;
    font: inherit;
    cursor: pointer;
    text-shadow: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top:hover {
    color: var(--color-foreground);
    transform: translateY(-1px);
  }

  .back-to-top:focus-visible {
    border-radius: 0.125rem;
    outline: 1px solid var(--color-foreground);
    outline-offset: 0.25rem;
  }

  .back-to-top-label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .back-to-top-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.35;
  }

  @media (max-width: 1023px) {
    .back-to-top {
      right: max(0.15rem, env(safe-area-inset-right));
      bottom: max(0.25rem, env(safe-area-inset-bottom));
      min-width: 2.75rem;
      height: 2.75rem;
    }

    .back-to-top-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
