---
import { themeConfig } from '~/.config'

const year = new Date().getFullYear()

const { website, author, footer } = themeConfig.site
const licenseUrl = 'https://creativecommons.org/licenses/by-nc-sa/4.0/'

function parseFooter(str: string) {
  str = str.replace(/%author/g, author)
  str = str.replace(/%website/g, website)
  str = str.replace(/%year/g, year.toString())
  return str
}
---

{footer.length && footer.map((str) => <p set:html={parseFooter(str)} />)}

<a
  class="license-mark not-underline-hover"
  href={licenseUrl}
  target="_blank"
  rel="license noopener noreferrer"
  aria-label="Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International"
>
  <span class="i-mdi-creative-commons license-icon" aria-hidden="true"></span>
  <span class="license-terms">BY–NC–SA</span>
  <span class="license-version">4.0</span>
</a>

<style>
  p {
    --at-apply: 'font-bold text-3';
  }

  .license-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 24%, transparent);
    color: inherit;
    font-family: var(--font-app);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.045em;
    opacity: 0.64;
    transition:
      border-color 160ms ease,
      opacity 160ms ease;
  }

  .license-mark:hover,
  .license-mark:focus-visible {
    border-color: currentColor;
    opacity: 1;
  }

  .license-mark:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 0.2rem;
  }

  .license-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .license-version {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    opacity: 0.72;
  }
</style>
