---
interface GitHubRepository {
  name: string
  html_url: string
  description: string | null
  language: string | null
  pushed_at: string
  stargazers_count: number
  fork: boolean
  archived: boolean
  disabled: boolean
}

type Project = Pick<
  GitHubRepository,
  'name' | 'html_url' | 'description' | 'language' | 'pushed_at' | 'stargazers_count'
>

const GITHUB_USERNAME = 'zhui-zi'
const EXCLUDED_REPOSITORIES = new Set(['blog', GITHUB_USERNAME])
const PROFILE_URL = `https://github.com/${GITHUB_USERNAME}`
const API_QUERY = new URLSearchParams({
  sort: 'pushed',
  direction: 'desc',
  per_page: '20',
}).toString()
const API_URL = `https://api.github.com/users/${GITHUB_USERNAME}/repos?${API_QUERY}`

const fallbackProjects: Project[] = [
  {
    name: 'DalamudPlugins',
    html_url: 'https://github.com/zhui-zi/DalamudPlugins',
    description: 'Personal Dalamud plugin repository',
    language: 'C#',
    pushed_at: '2026-08-12T12:03:41Z',
    stargazers_count: 0,
  },
  {
    name: '2bot',
    html_url: 'https://github.com/zhui-zi/2bot',
    description: 'Public AstrBot plugins for a personal QQ bot.',
    language: 'Python',
    pushed_at: '2026-08-12T10:05:50Z',
    stargazers_count: 0,
  },
]

function isRepository(value: unknown): value is GitHubRepository {
  if (!value || typeof value !== 'object') {
    return false
  }
  const repo = value as Partial<GitHubRepository>
  return (
    typeof repo.name === 'string' &&
    typeof repo.html_url === 'string' &&
    typeof repo.pushed_at === 'string' &&
    typeof repo.fork === 'boolean' &&
    typeof repo.archived === 'boolean' &&
    typeof repo.disabled === 'boolean'
  )
}

function selectProjects(value: unknown): Project[] {
  if (!Array.isArray(value)) return []
  return value
    .filter(isRepository)
    .filter((repo) => !repo.fork && !repo.archived && !repo.disabled)
    .filter((repo) => !EXCLUDED_REPOSITORIES.has(repo.name))
    .sort((left, right) => Date.parse(right.pushed_at) - Date.parse(left.pushed_at))
    .slice(0, 2)
}

async function getProjects(): Promise<Project[]> {
  try {
    const headers = new Headers({
      Accept: 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
    })
    const token = import.meta.env.GITHUB_TOKEN
    if (token) {
      headers.set('Authorization', `Bearer ${token}`)
    }

    const response = await fetch(API_URL, {
      headers,
      signal: AbortSignal.timeout(5000),
    })
    if (!response.ok) {
      return fallbackProjects
    }

    const projects = selectProjects(await response.json())
    return projects.length === 2 ? projects : fallbackProjects
  } catch {
    return fallbackProjects
  }
}

const projects = await getProjects()
const formatProjectDate = (value: string) => value.slice(0, 10)
---

<section
  class="home-projects"
  data-recent-projects
  data-github-user={GITHUB_USERNAME}
  data-excluded-repositories={[...EXCLUDED_REPOSITORIES].join(',')}
>
  <header class="home-projects-header">
    <div>
      <p class="home-projects-eyebrow">Latest from GitHub</p>
      <h2>Recent Projects</h2>
    </div>
    <a class="home-projects-all" href={PROFILE_URL} target="_blank" rel="noopener noreferrer">
      View all <span aria-hidden="true">&#8599;</span>
    </a>
  </header>

  <ul class="project-list" data-project-list aria-live="polite">
    {
      projects.map((project) => (
        <li>
          <a class="project-card not-underline-hover" href={project.html_url} target="_blank" rel="noopener noreferrer">
            <span class="project-card-heading">
              <strong>{project.name}</strong>
              <span aria-hidden="true">&#8599;</span>
            </span>
            <span class="project-card-description">{project.description ?? `${project.name} on GitHub`}</span>
            <span class="project-card-meta">
              {project.language && <span>{project.language}</span>}
              <time datetime={project.pushed_at}>Updated {formatProjectDate(project.pushed_at)}</time>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  /* eslint-disable style/brace-style, style/member-delimiter-style */
  interface ClientRepository {
    name: string
    html_url: string
    description: string | null
    language: string | null
    pushed_at: string
    fork: boolean
    archived: boolean
    disabled: boolean
  }

  const CACHE_KEY = 'keita-recent-projects'
  const CACHE_TTL = 10 * 60 * 1000

  function isClientRepository(value: unknown): value is ClientRepository {
    if (!value || typeof value !== 'object') {
      return false
    }
    const repo = value as Partial<ClientRepository>
    return [
      typeof repo.name === 'string',
      typeof repo.html_url === 'string',
      typeof repo.pushed_at === 'string',
      typeof repo.fork === 'boolean',
      typeof repo.archived === 'boolean',
      typeof repo.disabled === 'boolean',
    ].every(Boolean)
  }

  function readProjectCache(): ClientRepository[] | undefined {
    try {
      const cached = sessionStorage.getItem(CACHE_KEY)
      if (!cached) {
        return undefined
      }
      const value = JSON.parse(cached) as { expires?: number; projects?: unknown }
      if (!value.expires || value.expires < Date.now() || !Array.isArray(value.projects)) {
        return undefined
      }
      return value.projects.filter(isClientRepository)
    } catch {
      return undefined
    }
  }

  function writeProjectCache(projects: ClientRepository[]) {
    try {
      sessionStorage.setItem(
        CACHE_KEY,
        JSON.stringify({
          expires: Date.now() + CACHE_TTL,
          projects,
        }),
      )
    } catch {
      return undefined
    }
  }

  function renderProjects(section: HTMLElement, projects: ClientRepository[]) {
    const list = section.querySelector<HTMLUListElement>('[data-project-list]')
    if (!list) {
      return
    }

    const items = projects.map((project) => {
      const item = document.createElement('li')
      const link = document.createElement('a')
      const heading = document.createElement('span')
      const name = document.createElement('strong')
      const arrow = document.createElement('span')
      const description = document.createElement('span')
      const meta = document.createElement('span')
      const updated = document.createElement('time')

      link.className = 'project-card not-underline-hover'
      link.href = project.html_url
      link.target = '_blank'
      link.rel = 'noopener noreferrer'
      heading.className = 'project-card-heading'
      name.textContent = project.name
      arrow.textContent = '\u2197'
      arrow.setAttribute('aria-hidden', 'true')
      description.className = 'project-card-description'
      description.textContent = project.description || `${project.name} on GitHub`
      meta.className = 'project-card-meta'

      if (project.language) {
        const language = document.createElement('span')
        language.textContent = project.language
        meta.append(language)
      }

      updated.dateTime = project.pushed_at
      updated.textContent = `Updated ${project.pushed_at.slice(0, 10)}`
      meta.append(updated)
      heading.append(name, arrow)
      link.append(heading, description, meta)
      item.append(link)
      return item
    })

    list.replaceChildren(...items)
  }

  async function refreshRecentProjects(section: HTMLElement) {
    if (section.dataset.refreshing) {
      return
    }
    section.dataset.refreshing = 'true'

    const excluded = new Set((section.dataset.excludedRepositories ?? '').split(','))
    const cached = readProjectCache()
    if (cached?.length === 2) {
      renderProjects(section, cached)
      delete section.dataset.refreshing
      return
    }

    try {
      const username = section.dataset.githubUser
      if (!username) {
        return
      }
      const query = new URLSearchParams({
        sort: 'pushed',
        direction: 'desc',
        per_page: '20',
      }).toString()
      const apiUrl = `https://api.github.com/users/${encodeURIComponent(username)}/repos?${query}`
      const response = await fetch(apiUrl, { headers: { Accept: 'application/vnd.github+json' } })
      if (!response.ok) {
        return
      }

      const value: unknown = await response.json()
      if (!Array.isArray(value)) {
        return
      }
      const projects = value
        .filter(isClientRepository)
        .filter((repo) => !repo.fork && !repo.archived && !repo.disabled)
        .filter((repo) => !excluded.has(repo.name))
        .sort((left, right) => Date.parse(right.pushed_at) - Date.parse(left.pushed_at))
        .slice(0, 2)

      if (projects.length === 2) {
        renderProjects(section, projects)
        writeProjectCache(projects)
      }
    } finally {
      delete section.dataset.refreshing
    }
  }

  function setupRecentProjects() {
    document.querySelectorAll<HTMLElement>('[data-recent-projects]').forEach(refreshRecentProjects)
  }

  setupRecentProjects()
  document.addEventListener('astro:page-load', setupRecentProjects)
</script>

<style is:global>
  .home-projects {
    margin-bottom: 2.75rem;
    padding-bottom: 1.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  .home-projects-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .home-projects-eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.55;
    text-transform: uppercase;
  }

  .home-projects h2 {
    margin: 0;
    font-family: theme('fontFamily.header');
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .home-projects-all {
    flex: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .project-list > li {
    min-width: 0;
  }

  .project-list > li:first-child {
    padding-right: 1.25rem;
  }

  .project-list > li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }

  .project-card {
    display: flex;
    height: 100%;
    box-sizing: border-box;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 0 0.15rem;
    color: inherit;
    text-decoration: none;
  }

  .project-card-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    font-family: theme('fontFamily.header');
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .project-card-heading strong {
    padding: 0 0.1rem;
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.16em;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .project-card-heading > span {
    font-family: var(--font-app);
    font-size: 0.78rem;
    opacity: 0.7;
    transition: transform 180ms ease;
  }

  .project-card:hover .project-card-heading strong,
  .project-card:focus-visible .project-card-heading strong {
    color: var(--color-background);
    background: var(--color-foreground);
  }

  .project-card:hover .project-card-heading > span {
    transform: translate(2px, -2px);
  }

  .project-card-description {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.88rem;
    line-height: 1.55;
    opacity: 0.76;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: auto;
    padding-top: 0.15rem;
    font-size: 0.74rem;
    opacity: 0.55;
  }

  .project-card-meta > * + *::before {
    margin-inline: 0.5rem;
    content: '\00b7';
  }

  .project-card:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 0.35rem;
  }

  @media (max-width: 640px) {
    .home-projects {
      margin-bottom: 2.25rem;
      padding-bottom: 1.75rem;
    }

    .project-list {
      grid-template-columns: 1fr;
    }

    .project-list > li:first-child {
      padding-right: 0;
    }

    .project-list > li + li {
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
