<nav class="table-of-contents not-prose" data-table-of-contents aria-label="文章目录" hidden>
  <details open>
    <summary>目录</summary>
    <ol data-toc-list></ol>
  </details>
</nav>

<script>
  function createHeadingId(text: string) {
    return (
      text
        .normalize('NFKC')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\p{Letter}\p{Number}\-_]/gu, '') || 'section'
    )
  }

  function setupTableOfContents() {
    document.querySelectorAll<HTMLElement>('[data-table-of-contents]').forEach((toc) => {
      if (toc.dataset.ready) {
        return
      }
      const article = toc.closest<HTMLElement>('.post-article')
      const content = article?.querySelector<HTMLElement>('.post-content')
      const list = toc.querySelector<HTMLOListElement>('[data-toc-list]')
      if (!content || !list) {
        return
      }

      const headings = Array.from(content.querySelectorAll<HTMLHeadingElement>('h1, h2, h3, h4'))
        .filter((heading) => !heading.hasAttribute('data-toc-ignore'))
        .filter((heading) => Boolean(heading.textContent?.trim()))
      if (!headings.length) {
        return
      }

      const minimumLevel = Math.min(...headings.map((heading) => Number(heading.tagName.slice(1))))
      const usedIds = new Set(Array.from(document.querySelectorAll<HTMLElement>('[id]')).map((node) => node.id))
      const items = headings.map((heading) => {
        if (!heading.id) {
          const baseId = createHeadingId(heading.textContent ?? '')
          let id = baseId
          let suffix = 2
          while (usedIds.has(id)) {
            id = `${baseId}-${suffix++}`
          }
          heading.id = id
          usedIds.add(id)
        }

        const item = document.createElement('li')
        const link = document.createElement('a')
        const level = Number(heading.tagName.slice(1))
        item.style.setProperty('--toc-indent', `${Math.max(0, level - minimumLevel) * 0.7}rem`)
        link.href = `#${heading.id}`
        link.textContent = heading.textContent?.trim() ?? ''
        link.addEventListener('click', (event) => {
          event.preventDefault()
          heading.scrollIntoView({ behavior: 'smooth', block: 'start' })
          history.replaceState(null, '', `#${encodeURIComponent(heading.id)}`)
        })
        item.append(link)
        return item
      })

      list.replaceChildren(...items)
      toc.hidden = false
      toc.dataset.ready = 'true'
    })
  }

  setupTableOfContents()
  document.addEventListener('astro:page-load', setupTableOfContents)
</script>

<style>
  .table-of-contents {
    margin: 1.5rem 0 2rem;
    padding: 0.85rem 1rem;
    border-left: 0.2rem solid color-mix(in srgb, var(--color-foreground) 45%, transparent);
    background: color-mix(in srgb, var(--color-background) 91%, var(--color-foreground) 9%);
  }

  .table-of-contents summary {
    width: fit-content;
    font-weight: 700;
    cursor: pointer;
    user-select: none;
  }

  .table-of-contents ol {
    max-height: 18rem;
    overflow-x: hidden;
    overflow-y: auto;
    margin: 0.75rem 0 0;
    padding: 0 0.25rem 0 0;
    list-style: none;
    scrollbar-width: thin;
  }

  .table-of-contents li {
    margin: 0.28rem 0 0.28rem var(--toc-indent, 0);
    line-height: 1.45;
  }

  .table-of-contents a {
    display: inline-block;
    overflow: hidden;
    max-width: 100%;
    padding: 0.05rem 0;
    color: inherit;
    font-size: 0.83rem;
    opacity: 0.7;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .table-of-contents a:hover {
    opacity: 1;
  }
</style>
