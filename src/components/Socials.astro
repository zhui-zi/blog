---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const linkClass =
  "inline-flex size-9 items-center justify-center rounded text-xl transition duration-200 hover:-translate-y-0.5 hover:rotate-6 hover:scale-110 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus-visible:outline-dashed sm:size-8";
---

<div class="flex flex-wrap items-center gap-1.5">
  {
    SOCIALS.map(social =>
      "type" in social ? (
        <div
          class="flex flex-wrap items-center gap-1.5"
          role="group"
          aria-label={social.ariaLabel}
        >
          {social.links.map(link =>
            link.action === "copy" ? (
              <button
                type="button"
                class={linkClass}
                data-copy={link.copyText}
                data-copied-label={link.copiedLabel}
                title={link.copyText}
                aria-label={`${link.name}: ${link.copyText}`}
              >
                <span aria-hidden="true">{link.emoji}</span>
                <span class="sr-only">{link.name}</span>
              </button>
            ) : (
              <LinkButton
                href={link.url}
                class={linkClass}
                title={link.name}
                aria-label={link.name}
              >
                <span aria-hidden="true">{link.emoji}</span>
                <span class="sr-only">{link.name}</span>
              </LinkButton>
            )
          )}
        </div>
      ) : social.action === "copy" ? (
        <button
          type="button"
          class={linkClass}
          data-copy={social.copyText}
          data-copied-label={social.copiedLabel}
          title={social.copyText}
          aria-label={`${social.name}: ${social.copyText}`}
        >
          <span aria-hidden="true">{social.emoji}</span>
          <span class="sr-only">{social.name}</span>
        </button>
      ) : (
        <LinkButton
          href={social.url}
          class={linkClass}
          title={social.name}
          aria-label={social.name}
        >
          <span aria-hidden="true">{social.emoji}</span>
          <span class="sr-only">{social.name}</span>
        </LinkButton>
      )
    )
  }
</div>

<script>
  function setupCopySocials() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-copy]");

    buttons.forEach(button => {
      if (button.dataset.copyReady) return;
      button.dataset.copyReady = "true";

      const label = button.querySelector("span:last-child");
      const originalLabel = label?.textContent ?? "";
      const copiedLabel = button.dataset.copiedLabel ?? "Copied";

      button.addEventListener("click", async () => {
        const text = button.dataset.copy;
        if (!text) return;

        await navigator.clipboard.writeText(text);
        if (label) label.textContent = copiedLabel;
        button.title = copiedLabel;

        window.setTimeout(() => {
          if (label) label.textContent = originalLabel;
          button.title = text;
        }, 1500);
      });
    });
  }

  setupCopySocials();
  document.addEventListener("astro:after-swap", setupCopySocials);
</script>
