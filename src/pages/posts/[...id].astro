---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Comments from '~/components/Comments.astro'
import Pagination from '~/components/Pagination.astro'
import QuizEQ from '~/components/QuizEQ.astro'
import QuizSM from '~/components/QuizSM.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import LayoutPost from '~/layouts/LayoutPost.astro'
import { getPostId, getPostPath, getPosts } from '~/utils'
import { render } from 'astro:content'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post, idx) => {
    const prev = posts[idx - 1]
    const next = posts[idx + 1]
    return {
      params: { id: getPostId(post) },
      props: { entry: post, next, prev },
    }
  })
}) satisfies GetStaticPaths

// type Params = InferGetStaticParamsType<typeof getStaticPaths>
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const { translate: t } = Astro.locals
---

<LayoutDefault>
  <SiteSeo slot="seo" title={entry.data.title} desc={entry.data.description} banner={entry.data.banner} />

  <LayoutPost post={entry}>
    {entry.data.quizPage === 'eq' && <QuizEQ />}
    {entry.data.quizPage === 'sm' && <QuizSM />}
    {
      !entry.data.quizPage && (
        <div class="post-content">
          <Content />
        </div>
      )
    }
  </LayoutPost>

  <Pagination
    showLeft={Boolean(prev)}
    leftTitle={`${t('prev_post')}: ${prev?.data.title}`}
    leftUrl={prev ? getPostPath(prev) : undefined}
    showRight={Boolean(next)}
    rightTitle={`${t('next_post')}: ${next?.data.title}`}
    rightUrl={next ? getPostPath(next) : undefined}
    showPageCount={false}
  />
  <!-- Using client:visible here breaks static builds. See https://github.com/withastro/astro/issues/7329. -->
  <Comments post={entry} />
</LayoutDefault>
