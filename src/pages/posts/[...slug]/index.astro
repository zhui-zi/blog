---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import QuizEQ from "@/layouts/QuizEQ.astro";
import QuizSM from "@/layouts/QuizSM.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const postResult = posts.map(post => ({
    params: { slug: getPath(post.id, post.filePath, false) },
    props: { post },
  }));

  return postResult;
}

const { post } = Astro.props;

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
---

{post.data.quizPage === 'eq' && <QuizEQ post={post} posts={sortedPosts} />}
{post.data.quizPage === 'sm' && <QuizSM post={post} posts={sortedPosts} />}
{!post.data.quizPage && <PostDetails post={post} posts={sortedPosts} />}
