  function bindFormEvents(root) {
    root.addEventListener('change', function(e) {
      if (!e.target || e.target.type !== 'radio') return;
      var name = e.target.name;
      var val  = e.target.value;

      // Update visual selection
      root.querySelectorAll('label[data-name="' + name + '"]').forEach(function(lbl) {
        lbl.classList.remove('is-selected');
      });
      var input = root.querySelector('input[name="' + name + '"][value="' + val + '"]');
      if (input) {
        var lbl = input.closest('label');
        if (lbl) lbl.classList.add('is-selected');
      }

      // Clear unanswered highlight
      var card = document.getElementById('eq-q' + name.slice(1));
      if (card) card.classList.remove('unanswered-highlight');

      updateProgress(root);
    });

    document.getElementById('eq-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var answers = {};
      fd.forEach(function(v, k) { answers[k] = v; });

      var n = Object.keys(answers).length;
      if (n < TOTAL) {
        var errEl = document.getElementById('eq-error');
        errEl.style.display = 'block';
        errEl.textContent = '还有 ' + (TOTAL - n) + ' 题未作答，请完成所有题目后再提交。';

        var names = []
          .concat(P1Q.map(function(q) { return 'q'+q.n; }))
          .concat(P2Q.map(function(q) { return 'q'+q.n; }))
          .concat(P3Q.map(function(q) { return 'q'+q.n; }));
        var first = null;
        names.forEach(function(nm) {
          var card = document.getElementById('eq-' + nm);
          if (card && !answers[nm]) {
            card.classList.add('unanswered-highlight');
            if (!first) first = card;
          }
        });
        if (first) first.scrollIntoView({ behavior:'smooth', block:'center' });
        return;
      }

      var result = calcScores(answers);
      showResults(root, result);
      root.scrollIntoView({ behavior:'smooth', block:'start' });
    });
  }

  function updateProgress(root) {
    var n = (root || document).querySelectorAll('#eq-form input[type="radio"]:checked').length;
    var cnt  = document.getElementById('eq-cnt');
    var fill = document.getElementById('eq-fill');
    if (cnt)  cnt.textContent = n;
    if (fill) fill.style.width = Math.round(n / TOTAL * 100) + '%';
  }

  // ─── Scoring ─────────────────────────────────────────────────────

  function calcScores(ans) {
    var sc = {};
    P1Q.forEach(function(q, qi) {
      var idx = LBL.indexOf(ans['q'+q.n]);
      sc[q.n] = idx >= 0 ? P1S[qi][idx] : 0;
    });
    P2Q.forEach(function(q) {
      var v = parseInt(ans['q'+q.n] || '3', 10);
      sc[q.n] = q.rev ? 6 - v : v;
    });
    P3Q.forEach(function(q) {
      var v = parseInt(ans['q'+q.n] !== undefined ? ans['q'+q.n] : '-1', 10);
      sc[q.n] = v === q.c ? 4 : 0;
    });

    var p1 = P1Q.reduce(function(s,q){return s+(sc[q.n]||0);},0);
    var p2 = P2Q.reduce(function(s,q){return s+(sc[q.n]||0);},0);
    var p3 = P3Q.reduce(function(s,q){return s+(sc[q.n]||0);},0);
    var tot = p1+p2+p3;
    var pct = Math.round(tot/212*100);

    var dims = DIMS.map(function(d) {
      var got = d.qs.reduce(function(s,n){return s+(sc[n]||0);},0);
      return { name:d.name, got:got, max:d.max, pct:Math.round(got/d.max*100) };
    });

    // L-scale
    var flags = [];
    var r = function(k){ return parseInt(ans['q'+k]||'0',10); };
    if (r(33)===5 && r(42)===1) flags.push('第 33 题选 5 且第 42 题选 1');
    if (r(38)===1)               flags.push('第 38 题选 1（从不后悔冲动之言）');
    if (r(48)===1 && r(32)===5)  flags.push('第 48 题选 1 且第 32 题选 5（逻辑张力）');
    var maxCount = P1Q.filter(function(q,i){
      var idx = LBL.indexOf(ans['q'+q.n]);
      return idx>=0 && P1S[i][idx]===3;
    }).length;
    if (maxCount/30 > 0.85) flags.push('第一部分满分项占比 '+maxCount+'/30');

    return { p1:p1, p2:p2, p3:p3, tot:tot, pct:pct, dims:dims, flags:flags };
  }

  // ─── Results ─────────────────────────────────────────────────────

  function getLevel(pct) {
    if (pct >= 85) return { label:'很高',  desc:'情绪识别、理解与调节能力整合度高，在压力与人际情境中表现稳定。' };
    if (pct >= 70) return { label:'较高',  desc:'大多数情境处理得当，少数高压或冲突情境仍有提升空间。' };
    if (pct >= 55) return { label:'中等',  desc:'具备基本情绪能力，在自我调节或共情某一环节存在明显短板。' };
    if (pct >= 40) return { label:'偏低',  desc:'易被情绪驱动或回避情绪，建议在具体维度上有针对性练习。' };
    return            { label:'低',    desc:'多个维度均需系统性提升；若伴随长期困扰，建议寻求专业支持。' };
  }

  function showResults(root, res) {
    var lv = getLevel(res.pct);
    var h = '';
    h += '<h1 style="font-size:1.35rem;font-weight:500;letter-spacing:0.04em;margin:0 0 1.25rem;">测评结果</h1>';

    if (res.flags.length >= 3) {
      h += '<div class="eq-validity">';
      h += '<strong>效度提示</strong>（触发 '+res.flags.length+' 条警示）<br>';
      h += '本次结果可能反映「理想自我形象」而非真实水平。建议放松后重测，或思考「为什么想呈现这样的形象」。';
      h += '</div>';
    }

    // Score header
    h += '<div class="eq-result-header">';
    h += '<div class="eq-score-pct">'+res.pct+'<span class="eq-score-pct-sign">%</span></div>';
    h += '<div class="eq-score-raw">总得分 '+res.tot+' / 212</div>';
    h += '<div class="eq-level-pill">情商水平：'+lv.label+'</div>';
    h += '<p class="eq-level-desc">'+lv.desc+'</p>';
    h += '</div>';

    // Radar
    h += '<div class="eq-radar-wrap"><canvas id="eq-radar" width="420" height="420"></canvas></div>';

    // Dimensions
    h += '<div class="eq-card">';
    h += '<p class="eq-card-title">七维得分详情</p>';
    res.dims.forEach(function(d) {
      h += '<div class="eq-dim-row">';
      h += '<div class="eq-dim-meta"><span class="eq-dim-name">'+d.name+'</span><span class="eq-dim-val">'+d.got+'/'+d.max+'&ensp;·&ensp;'+d.pct+'%</span></div>';
      h += '<div class="eq-bar-track"><div class="eq-bar-fill" style="width:'+d.pct+'%"></div></div>';
      h += '</div>';
    });
    h += '</div>';

    // Sub-scores
    h += '<div class="eq-card">';
    h += '<p class="eq-card-title">分部得分</p>';
    h += '<div class="eq-sub-grid">';
    [['情境判断',res.p1,90],['自我陈述',res.p2,90],['知识理解',res.p3,32]].forEach(function(it) {
      h += '<div><div class="eq-sub-score">'+it[1]+'<span class="eq-sub-unit">/'+it[2]+'</span></div><div class="eq-sub-lbl">'+it[0]+'</div></div>';
    });
    h += '</div></div>';

    h += '<p class="eq-disclaimer">本测评为教育与自我发展用途，未经大规模常模标定，结果仅供参考。</p>';
    h += '<button class="eq-reset" id="eq-reset">重新测评</button>';

    root.innerHTML = h;
    document.getElementById('eq-reset').addEventListener('click', function() {
      renderQuiz(root);
      root.scrollIntoView({ behavior:'smooth', block:'start' });
    });
    loadChart().then(function() { drawRadar(res.dims); });
  }

  function loadChart() {
    if (window.Chart) return Promise.resolve();
    return new Promise(function(resolve, reject) {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js';
      s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  function drawRadar(dims) {
    var canvas = document.getElementById('eq-radar');
    if (!canvas) return;
    var dark = document.documentElement.dataset.theme === 'dark';
    var fg   = dark ? '#d0ccbd' : '#434343';
    var fill = dark ? 'rgba(208,204,189,0.15)' : 'rgba(67,67,67,0.10)';
    var grid = dark ? 'rgba(208,204,189,0.12)' : 'rgba(67,67,67,0.10)';
    new window.Chart(canvas, {
      type: 'radar',
      data: {
        labels: dims.map(function(d){return d.name;}),
        datasets: [{ data: dims.map(function(d){return d.pct;}),
          backgroundColor: fill, borderColor: fg, borderWidth: 1.5,
          pointBackgroundColor: fg, pointRadius: 3, pointHoverRadius: 5 }]
      },
      options: {
        responsive: true,
        animation: { duration: 700 },
        scales: { r: {
          min:0, max:100,
          ticks: { stepSize:25, display:false, backdropColor:'transparent' },
          grid: { color: grid },
          angleLines: { color: grid },
          pointLabels: { color: fg, font: { size: 12 } }
        }},
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function(c){ return c.raw+'%'; } } }
        }
      }
    });
  }

  // ─── Init ─────────────────────────────────────────────────────────

  function init() {
    var root = document.getElementById('eq-root');
    if (root) renderQuiz(root);
  }

  document.addEventListener('astro:page-load', init);

})();
</script>
