    // Part 3
    h += '<div class="eq-section">';
    h += '<p class="eq-section-eyebrow">Part 3 · 情绪理解</p>';
    h += '<h2 class="eq-section-title">情绪识别与理解题（共 8 题）</h2>';
    h += '<p class="eq-section-note">测量对情绪线索与规律的理解，每题选一个最恰当的答案。</p>';
    h += '</div>';

    P3Q.forEach(function(q) {
      h += '<div class="eq-q" id="eq-q' + q.n + '">';
      h += '<div class="eq-q-head">';
