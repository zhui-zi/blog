      h += '<p class="eq-q-stem">' + q.s + '</p>';
      h += '</div>';
      h += '<div class="eq-opts"><div class="eq-likert">';
      h += '<span class="eq-likert-label">完全不符合</span>';
      h += '<div class="eq-likert-btns">';
      for (var v = 1; v <= 5; v++) {
        h += '<label class="eq-lk" data-name="q' + q.n + '">';
        h += '<input type="radio" name="q' + q.n + '" value="' + v + '">';
        h += v;
