  var LBL = ['A','B','C','D'];
  var TOTAL = 56;

  // ─── Render Quiz ──────────────────────────────────────────────────

  function renderQuiz(root) {
    var h = '';
    h += '<h1 style="font-size:1.35rem;font-weight:500;letter-spacing:0.04em;margin:0 0 1.5rem;">情商（情绪智力）综合测评</h1>';

