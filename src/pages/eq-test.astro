---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";
---

<Layout
  title={`情商综合测评 | ${SITE.title}`}
  description="综合情商互动测评，自动算分，生成七维能力雷达图。整合 Mayer-Salovey-Caruso、Goleman 与 Bar-On 三大框架。"
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <div id="eq-root" class="py-8"></div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* All rules scoped to #eq-root — no effect on other pages */

  #eq-root p, #eq-root h1, #eq-root h2 {
    margin: 0; padding: 0;
    font-size: inherit; font-weight: inherit; line-height: inherit;
  }

  /* ── Progress bar ── */
  #eq-root .eq-progress {
    position: sticky; top: 0; z-index: 20;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 0 0; margin-bottom: 2rem;
  }
  #eq-root .eq-progress-text {
    text-align: center; font-size: 0.8rem;
    color: var(--color-muted); padding-bottom: 0.4rem;
  }
  #eq-root .eq-progress-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-muted) 40%, transparent);
  }
  #eq-root .eq-progress-fill {
    height: 100%; background: var(--color-foreground);
    transition: width 0.35s ease;
  }

  /* ── Section header ── */
  #eq-root .eq-section { margin-top: 3rem; margin-bottom: 1.75rem; }
  #eq-root .eq-section-eyebrow {
    font-size: 0.72rem; letter-spacing: 0.12em;
    color: var(--color-muted); text-transform: uppercase;
    margin: 0 0 0.35rem;
  }
  #eq-root .eq-section-title {
    font-size: 1.1rem; font-weight: 500; letter-spacing: 0.02em;
    margin: 0 0 0.4rem; padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  #eq-root .eq-section-note {
    font-size: 0.83rem; color: var(--color-muted);
    margin: 0.5rem 0 0; line-height: 1.7;
  }

  /* ── Question card ── */
  #eq-root .eq-q {
    border: 1px solid var(--color-border); border-radius: 5px;
    margin-bottom: 1.25rem; transition: border-color 0.2s; overflow: hidden;
  }
  #eq-root .eq-q.unanswered-highlight {
    border-color: #b03a2e; box-shadow: 0 0 0 1px #b03a2e22;
  }
  #eq-root .eq-q-head {
    padding: 1.1rem 1.25rem 0.85rem;
    display: flex; gap: 0.7rem; align-items: flex-start;
  }
  #eq-root .eq-q-num {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em;
    color: var(--color-muted); min-width: 1.6rem;
    padding-top: 0.22rem; flex-shrink: 0;
  }
  #eq-root .eq-q-stem { font-size: 0.93rem; line-height: 1.75; margin: 0; }
  #eq-root .eq-opts {
    padding: 0 1.25rem 1.1rem;
    display: flex; flex-direction: column; gap: 0.45rem;
  }

  /* ── SJT / Part-3 option rows ── */
  #eq-root .eq-opt {
    display: flex; align-items: stretch;
    border: 1px solid var(--color-border); border-radius: 4px;
    cursor: pointer; overflow: hidden;
    transition: border-color 0.15s; user-select: none;
  }
  #eq-root .eq-opt input[type="radio"] {
    position: absolute; opacity: 0; width: 0; height: 0;
  }
  #eq-root .eq-opt-badge {
    display: flex; align-items: center; justify-content: center;
    min-width: 2.6rem; padding: 0.62rem 0;
    background: color-mix(in srgb, var(--color-muted) 18%, var(--color-background) 82%);
    border-right: 1px solid var(--color-border);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
    color: var(--color-muted); flex-shrink: 0;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  #eq-root .eq-opt-text {
    padding: 0.62rem 0.9rem; font-size: 0.88rem; line-height: 1.65; flex: 1;
  }
  #eq-root .eq-opt:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
  #eq-root .eq-opt:hover .eq-opt-badge {
    border-right-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
  #eq-root .eq-opt.is-selected { border-color: var(--color-foreground); }
  #eq-root .eq-opt.is-selected .eq-opt-badge {
    background: var(--color-foreground); color: var(--color-background);
    border-right-color: var(--color-foreground);
  }
  #eq-root .eq-opt.is-selected .eq-opt-text { font-weight: 500; }

  /* ── Likert (Part 2) ── */
  #eq-root .eq-likert {
    display: flex; align-items: center;
    gap: 0.5rem; flex-wrap: wrap; row-gap: 0.6rem;
  }
  #eq-root .eq-likert-label {
    font-size: 0.75rem; color: var(--color-muted);
    white-space: nowrap; flex-shrink: 0;
  }
  #eq-root .eq-likert-btns {
    display: flex; gap: 0.5rem; flex-grow: 1; justify-content: center;
  }
  #eq-root .eq-lk {
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 0.82rem; flex-shrink: 0;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    user-select: none;
  }
  #eq-root .eq-lk input[type="radio"] {
    position: absolute; opacity: 0; width: 0; height: 0;
  }
  #eq-root .eq-lk:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
  #eq-root .eq-lk.is-selected {
    background: var(--color-foreground); color: var(--color-background);
    border-color: var(--color-foreground); font-weight: 600;
  }
  @media (max-width: 480px) {
    #eq-root .eq-likert-label { display: none; }
    #eq-root .eq-lk { width: 2.4rem; height: 2.4rem; }
  }

  /* ── Submit / Error ── */
  #eq-root .eq-error {
    color: #b03a2e; font-size: 0.85rem; text-align: center;
    margin: 0.75rem 0; display: none; line-height: 1.6;
  }
  #eq-root .eq-submit {
    display: block; margin: 2.5rem auto 0; padding: 0.75rem 2.75rem;
    background: var(--color-foreground); color: var(--color-background);
    border: none; border-radius: 4px; font-size: 0.95rem;
    font-family: var(--font-app); cursor: pointer;
    letter-spacing: 0.06em; transition: opacity 0.2s;
  }
  #eq-root .eq-submit:hover { opacity: 0.82; }

  /* ── Results ── */
  #eq-root .eq-result-header {
    text-align: center; padding: 2rem 1.5rem;
    border: 1px solid var(--color-border); border-radius: 5px; margin-bottom: 1.25rem;
  }
  #eq-root .eq-score-pct {
    font-size: 4rem; font-weight: 300; letter-spacing: -0.03em; line-height: 1;
  }
  #eq-root .eq-score-pct-sign { font-size: 1.8rem; }
  #eq-root .eq-score-raw {
    font-size: 0.82rem; color: var(--color-muted); margin: 0.25rem 0 0.8rem;
  }
  #eq-root .eq-level-pill {
    display: inline-block; padding: 0.22rem 1.1rem;
    border: 1px solid var(--color-border); border-radius: 2rem;
    font-size: 0.88rem; letter-spacing: 0.06em; margin-bottom: 0.7rem;
  }
  #eq-root .eq-level-desc {
    font-size: 0.85rem; color: var(--color-muted); line-height: 1.75; margin: 0;
  }
  #eq-root .eq-validity {
    background: color-mix(in srgb, #b03a2e 8%, var(--color-background) 92%);
    border: 1px solid color-mix(in srgb, #b03a2e 45%, transparent);
    border-radius: 5px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;
    font-size: 0.87rem; line-height: 1.8;
  }
  #eq-root .eq-card {
    border: 1px solid var(--color-border); border-radius: 5px;
    padding: 1.25rem; margin-bottom: 1.25rem;
  }
  #eq-root .eq-card-title {
    font-size: 0.82rem; letter-spacing: 0.08em;
    color: var(--color-muted); text-transform: uppercase; margin: 0 0 1.1rem;
  }
  #eq-root .eq-radar-wrap { max-width: 420px; margin: 0 auto 1.25rem; }
  #eq-root .eq-dim-row { margin-bottom: 1rem; }
  #eq-root .eq-dim-meta {
    display: flex; justify-content: space-between;
    align-items: baseline; margin-bottom: 0.3rem;
  }
  #eq-root .eq-dim-name { font-size: 0.88rem; }
  #eq-root .eq-dim-val { font-size: 0.8rem; color: var(--color-muted); }
  #eq-root .eq-bar-track {
    height: 5px;
    background: color-mix(in srgb, var(--color-muted) 35%, var(--color-background) 65%);
    border-radius: 3px; overflow: hidden;
  }
  #eq-root .eq-bar-fill {
    height: 100%; background: var(--color-foreground);
    border-radius: 3px; transition: width 0.7s ease;
  }
  #eq-root .eq-sub-grid {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem; text-align: center;
  }
  #eq-root .eq-sub-score { font-size: 1.5rem; font-weight: 300; }
  #eq-root .eq-sub-unit { font-size: 0.78rem; font-weight: 400; color: var(--color-muted); }
  #eq-root .eq-sub-lbl { font-size: 0.75rem; color: var(--color-muted); margin-top: 0.1rem; }
  #eq-root .eq-reset {
    display: block; margin: 1.5rem auto 0; padding: 0.6rem 1.75rem;
    background: transparent; color: var(--color-foreground);
    border: 1px solid var(--color-border); border-radius: 4px;
    font-size: 0.88rem; font-family: var(--font-app);
    cursor: pointer; letter-spacing: 0.04em; transition: background 0.15s;
  }
  #eq-root .eq-reset:hover {
    background: color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }
  #eq-root .eq-disclaimer {
    font-size: 0.75rem; color: var(--color-muted);
    text-align: center; line-height: 1.7; margin: 1rem 0 0;
  }
  #eq-root .eq-intro {
    border: 1px solid var(--color-border); border-radius: 5px;
    padding: 1.1rem 1.25rem; margin-bottom: 2.5rem;
    font-size: 0.87rem; line-height: 1.8;
  }
  #eq-root .eq-intro-title {
    font-size: 0.72rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-muted); margin: 0 0 0.5rem;
  }
  #eq-root .eq-intro ul { margin: 0; padding-left: 1.2rem; }
  #eq-root .eq-intro li { margin-bottom: 0.15rem; }
</style>

<script is:inline>
(function () {

  // ─── Data ────────────────────────────────────────────────────────

  var P1Q = [
    { n:1,  s:"你精心准备的方案在重要会议上被上级当众、略带嘲讽地否定。你的第一反应更接近：",
      o:["当场逐条反驳，把准备的论据全部摆出来","表面平静接受，会后向相熟同事吐槽上级不公","当场请上级具体指出需改进之处，并说会后再优化","沉默接受，回去后反复回想，开始怀疑自己的能力"] },
    { n:2,  s:"好友兴奋地向你展示他的创业计划，准备投入全部积蓄，但你看出其中有一个可能致命的漏洞。你会：",
      o:["不打击热情，先大力肯定，再轻描淡写提一句「可以再想想风险」","清晰、直接地指出你看到的漏洞，哪怕这会让他当场扫兴","表示支持，相信他自己迟早会发现问题","不当面说，私下联络其他朋友一起去劝"] },
    { n:3,  s:"同事在你背后散布了关于你的不实传言，今天你们要一起完成一个紧急项目。你会：",
      o:["先把项目做完，找一个双方都平静的时机当面澄清此事","立刻当面对质，要求对方道歉后再谈工作","装作不知情，但在合作中处处提防、保留证据","把这件事告诉共同上级，让上级处理"] },
    { n:4,  s:"你正经历低谷，一位朋友安慰你说「别想太多，这没什么大不了的」。你内心真实的感受更可能是：",
      o:["觉得被理解，心情确实轻松了一些","表面感谢，但其实觉得自己的感受被轻描淡写带过了","有点恼火，认为对方根本没懂","开始怀疑是不是自己反应过度了"] },
    { n:5,  s:"团队成员小张连续两周状态低迷、频繁出错，但从不主动说原因。作为同伴，你最可能：",
      o:["直接问他「你是不是最近遇到什么事了」，给他一个开口的机会","不点破，先默默帮他分担一部分工作，观察一阵","提醒他注意工作质量，把问题就事论事地说清","觉得这是他个人的事，不便介入"] },
    { n:6,  s:"你和伴侣争吵，对方说了一句很伤人的话后摔门而出。半小时后对方回来了，但一言不发。你会：",
      o:["主动开口：「刚才我们都说了气话，我们能平静聊聊吗？」","等对方先开口，不想显得是自己理亏","继续做自己的事，用沉默表达你还在生气","旧事重提，把刚才那句伤人的话再追究一遍"] },
    { n:7,  s:"你在一个新群体中，发现大家聊的话题你完全不熟悉，气氛热烈而你被晾在一边。你更可能：",
      o:["坦然说「这个我不太懂，能给我讲讲吗」，把劣势变成提问的机会","假装也懂，附和着点头微笑","安静旁听，等出现自己熟悉的话题再加入","找借口先离开这个场合"] },
    { n:8,  s:"下属交上来的报告质量明显下降，而你知道他最近家里出了事。你需要给反馈，你会：",
      o:["先肯定他过去的表现，再指出问题，最后问一句近况","只就报告本身给出具体的修改要求，不提家事","暂时不提报告问题，先关心他的状态","既指出问题，也明确告诉他「如果需要时间或帮助可以说」"] },
    { n:9,  s:"你升职了，而一起竞争的好友落选，对方主动来祝贺你，笑容里有一丝勉强。你会：",
      o:["热情道谢，主动提议改天一起吃饭聊聊","察觉到对方的勉强，淡化自己的喜悦，把话题转开","真诚道谢，同时不刻意回避，自然地说「这次也很险，你的方案很多地方比我强」","假装没看出异样，正常接受祝贺"] },
    { n:10, s:"你正在专注完成一个截止在即的任务，家人突然打电话来反复倾诉一件让他烦心的小事。你会：",
      o:["耐心听完，哪怕任务受影响","直接说「我现在很忙，晚点再说」然后挂断","简短回应情绪，约定一个具体时间再细聊：「听起来很烦，我手头有个急事，七点打给你好好聊？」","一边敷衍地「嗯嗯」，一边继续干活"] },
    { n:11, s:"会议上两位同事因意见不合气氛剑拔弩张，而你是中立方。你最可能：",
      o:["沉默，等他们自己平息","先点出双方各自有道理的地方，再把讨论拉回到共同目标上","明确支持你认为更对的一方，尽快结束争论","提议「先暂停，大家冷静一下再继续」"] },
    { n:12, s:"你发现自己最近经常无缘由地烦躁、对小事发火。你更可能：",
      o:["提醒自己「忍一忍就过去了」，尽量不发作","停下来想想，最近是不是睡眠、压力或某件未处理的事在影响我","觉得是周围的人和事确实太烦，问题不在自己","找朋友倾诉，把烦躁宣泄出来"] },
    { n:13, s:"一位平时强势的领导，在一次私下交流中突然流露出疲惫和自我怀疑。你会：",
      o:["安慰他「您已经做得很好了，别担心」","安静地听，不急于评价或给建议，让他把话说完","立刻给出几条解决问题的具体建议","觉得不太自然，尽快把话题转回工作"] },
    { n:14, s:"你答应了帮朋友一个忙，但事后发现这会严重挤占你自己的重要安排。你会：",
      o:["硬着头皮履行承诺，毕竟答应了","尽快联系朋友，坦诚说明情况并一起商量替代方案","找个理由临时推掉，避免说出真实原因","勉强去做，但心里埋怨，事后向别人抱怨"] },
    { n:15, s:"团队庆功宴上，气氛很高，但你注意到角落里有位贡献很大却内向的同事一直沉默。你会：",
      o:["不打扰，每个人放松的方式不同","自然走过去和他聊两句，提到他这次的关键贡献","在众人面前大声表扬他，让大家为他鼓掌","觉得他应该自己融入，不需要别人照顾"] },
    { n:16, s:"你收到一条措辞含糊的消息，无法判断对方是在开玩笑还是真的生气了。你会：",
      o:["按「对方在生气」来回应，先道歉再说","按「对方在开玩笑」来回应，轻松地接梗","直接问对方「我有点拿不准你是认真的还是开玩笑，能说清楚点吗」","暂时不回，等对方进一步表态"] },
    { n:17, s:"你长期努力的一个目标突然失败了，巨大的失落涌上来。当晚你最可能：",
      o:["强迫自己马上振作，列出下一步计划","允许自己难过一段时间，但给自己定一个「调整期限」","反复回想哪里做错了，难以入睡","找各种娱乐让自己彻底不去想这件事"] },
    { n:18, s:"一位新同事在你面前贬低了另一位你尊重的前辈。你会：",
      o:["附和着聊几句，避免气氛尴尬","不评论那位前辈，但平和地说出你自己接触下来的不同印象","当场反驳，维护前辈","沉默，但从此对这位新同事心存芥蒂"] },
    { n:19, s:"你正在气头上，需要回复一封会影响重要关系的邮件。你会：",
      o:["趁着情绪清晰，立刻把想说的都写出来发出去","先写下来但不发送，等情绪平复后再读一遍、修改后再发","等彻底冷静（哪怕几天）再处理，先放着","让别人替你看一遍把关再发"] },
    { n:20, s:"朋友向你哭诉一段感情，而你早就看出对方并不合适。此刻她只是想倾诉，并没问你意见。你会：",
      o:["趁机劝她「早该分了」，把你的判断说出来","先专注地接住她的情绪，暂时不评判对错","一边听一边委婉地引导她「自己看清」问题","听完后给出你认为最理性的分手建议"] },
    { n:21, s:"你察觉到自己对某位同事有种说不清的反感，但对方并没做错什么。你会：",
      o:["尽量避免和他接触，眼不见为净","反思这种反感从何而来，是否与自己的某些经历或偏见有关","认为直觉往往准，对他多加防备","努力对他更友善，以补偿这种不公平的反感"] },
    { n:22, s:"公开演讲前你心跳加速、手心出汗。你对这种紧张的解读更接近：",
      o:["「糟了，我太紧张了，可能会搞砸」","「身体在为重要时刻调动能量，这股劲儿可以帮我表现得更好」","「我必须让自己彻底平静下来才能上场」","「别人会看出我紧张的，太丢脸了」"] },
    { n:23, s:"你的建议被团队采纳并取得了成功，但功劳被组长在汇报中归到了自己名下。你会：",
      o:["忍下来，毕竟撕破脸不值得","找一个合适的私下场合，平静而清楚地向组长表达你的感受和诉求","在更大的场合「不经意」地提及这其实是你的主意","从此对这个团队心灰意冷，减少投入"] },
    { n:24, s:"你最好的朋友最近交了新朋友，明显和你疏远了。你心里不太好受。你会：",
